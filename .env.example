# Optional. Prefer entering your own key in the app (kept in memory).
# VITE_ values are visible in the built browser bundle; use only for personal use.
VITE_NANSEN_API_KEY=
# Optional override; defaults to Uniswap's Robinhood token page.
# Must be an HTTPS URL containing {token}.
VITE_ROBINHOOD_DEX_URL=
